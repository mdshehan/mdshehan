{
  "name": "global-gadget-price-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise international gadget price-comparison platform — monorepo",
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d postgres redis meilisearch minio",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @ggph/api prisma:migrate",
    "db:seed": "pnpm --filter @ggph/api prisma:seed",
    "db:studio": "pnpm --filter @ggph/api prisma:studio"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.2"
  }
}
