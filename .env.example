# Copy to .env and adjust. Portable connection strings (works against docker-compose).
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://ggph:ggph@localhost:5432/ggph?schema=public

# Redis (cache + queues)
REDIS_URL=redis://localhost:6379

# Search (Meilisearch)
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=ggph_dev_master_key

# Object storage (S3-compatible / MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ggph-media
S3_ACCESS_KEY=ggph
S3_SECRET_KEY=ggph_secret
S3_FORCE_PATH_STYLE=true

# API
API_PORT=4000
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
